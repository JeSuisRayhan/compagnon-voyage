name: Build Android APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Récupérer le code du dépôt
        uses: actions/checkout@v4

      - name: Installer Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"

      - name: Installer le JDK (nécessaire pour compiler Android)
        uses: actions/setup-java@v4
        with:
          distribution: "temurin"
          java-version: "17"

      - name: Installer les dépendances npm
        run: npm install

      - name: Ajouter la plateforme Android (générée à chaque build, pas besoin de la committer)
        run: npx cap add android

      - name: Synchroniser le code web dans le projet Android
        run: npx cap sync android

      - name: Autoriser l'exécution de gradlew
        run: chmod +x android/gradlew

      - name: Compiler l'APK (debug — installable directement sur un téléphone)
        run: cd android && ./gradlew assembleDebug --no-daemon

      - name: Mettre l'APK à disposition en téléchargement
        uses: actions/upload-artifact@v4
        with:
          name: compagnon-voyage-debug-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 30
